COLUMN TABLE "SLS_T_INJEM" (
    INJID       BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY    COMMENT 'Primary key - unique incident identifier',
    EMPID       NVARCHAR(40)    COMMENT 'Employee ID - references employee master record',
    EMPNM       NVARCHAR(100)   COMMENT 'Employee Name - full name of the employee',
    SUPVR       NVARCHAR(100)   COMMENT 'Supervisor Name - direct supervisor of the employee',
    TPHNE       NVARCHAR(20)    COMMENT 'Phone Number - contact number of the employee',
    CLSSF       VARCHAR(100)    COMMENT 'Incident Classification - category or type of incident',
    LDWRK       DATE            COMMENT 'Last Day Worked - last day employee worked before incident/absence',
    FDABS       DATE            COMMENT 'First Day of Absence - first day employee missed work due to incident',
    OCCIL       VARCHAR(1)      COMMENT 'Occupational Illness (Y/N) - indicates if incident is a work-related illness',
    RTWRK       VARCHAR(1)      COMMENT 'Return to Work (Y/N) - indicates if employee has returned to work',
    RGTIM       TIMESTAMP       COMMENT 'Regular Work Time - usual work time of employee',
    NAINC       NVARCHAR(255)   COMMENT 'Nature of Incident - description of what happened',
    CAUSE       NVARCHAR(255)   COMMENT 'Causes - contributing factors or causes of the incident',
    
    
    ISDEL       NVARCHAR(1)     COMMENT 'Delete Flag (Y/N) - marks record as logically deleted',
    CRTDT       DATE            COMMENT 'Created Date - record creation date',
    CRTTM       TIME            COMMENT 'Created Time - record creation time',
    CRTBY       NVARCHAR(30)    COMMENT 'Created By - user who created the record',
    CHNDT       DATE            COMMENT 'Changed Date - last modification date',
    CHNTM       TIME            COMMENT 'Changed Time - last modification time',
    CHNBY       NVARCHAR(30)    COMMENT 'Changed By - user who last modified the record'
)