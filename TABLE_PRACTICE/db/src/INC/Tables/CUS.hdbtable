COLUMN TABLE "CUS" (
    CS_ID       BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY    COMMENT 'Primary key - unique incident identifier',
    CUSID	    NVARCHAR(10)    COMMENT 'Customer ID',
    CNAME	    NVARCHAR(100)   COMMENT 'Customer Name - full name of the Customer',
    CNTRY	    NVARCHAR(50)    COMMENT 'COUNTRY Name',
    CUSTP   	NVARCHAR(20)    COMMENT 'B2B / B2C',
    
    
    ISDEL       NVARCHAR(1)     COMMENT 'Delete Flag (Y/N) - marks record as logically deleted',
    CRTDT       DATE            COMMENT 'Created Date - record creation date',
    CRTTM       TIME            COMMENT 'Created Time - record creation time',
    CRTBY       NVARCHAR(30)    COMMENT 'Created By - user who created the record',
    CHNDT       DATE            COMMENT 'Changed Date - last modification date',
    CHNTM       TIME            COMMENT 'Changed Time - last modification time',
    CHNBY       NVARCHAR(30)    COMMENT 'Changed By - user who last modified the record'
)