PROCEDURE "prCREATEUPDATEPRODUCTS"(
    IN PR_ID BIGINT,
    IN PROID NVARCHAR(10),
    IN PNAME NVARCHAR(100),
    IN CTGRY NVARCHAR(50),
    IN PRICE DECIMAL(10, 2),
    OUT oPR_ID BIGINT
  ) 
  LANGUAGE SQLSCRIPT 
  SQL SECURITY INVOKER 
  --    READS SQL DATA
  AS 
BEGIN
  DECLARE COLUMN_ID INTEGER;
  DECLARE QU NVARCHAR(150);
  DECLARE SEQ NVARCHAR(100);
  IF :PR_ID = 0 THEN 
  -- Insert new injury record
  INSERT INTO PRODUCTS (
      PROID,
      PNAME,
      CTGRY,
      PRICE,
      ISDEL,
      CRTDT,
      CRTTM,
      CRTBY,
      CHNDT,
      CHNTM,
      CHNBY
    )
  VALUES (
      :PROID,
      :PNAME,
      :CTGRY,
      :PRICE,
      0,
      CURRENT_DATE,
      CURRENT_TIME,
      SESSION_CONTEXT('APPLICATIONUSER'),
      CURRENT_DATE,
      CURRENT_TIME,
      SESSION_CONTEXT('APPLICATIONUSER')
    );
  SELECT '"_SYS_SEQUENCE_' || COLUMN_ID || '_#0_#"' INTO SEQ
  FROM TABLE_COLUMNS
  WHERE (TABLE_NAME = 'PRODUCTS')
    AND COLUMN_NAME = 'PR_ID';
  QU := 'select ' || SEQ || '.CURRVAL from DUMMY';
  EXECUTE IMMEDIATE QU INTO oPR_ID;
  -- SELECT CURRENT_IDENTITY_VALUE() INTO oPR_ID;
  -- FROM DUMMY;
  ELSE 
  -- Update existing injury record
  UPDATE PRODUCTS
  SET PROID = :PROID,
    PNAME = :PNAME,
    CTGRY = :CTGRY,
    PRICE = :PRICE,
    CHNBY = SESSION_CONTEXT('APPLICATIONUSER'),
    CHNDT = CURRENT_DATE,
    CHNTM = CURRENT_TIME
  WHERE PR_ID = :PR_ID
    AND ISDEL = 0;
  oPR_ID = :PR_ID;
END IF;
END;