PROCEDURE "prCREATEUPDATECUST"( 
    IN CS_ID        BIGINT, 
    IN CUSID	    NVARCHAR(10),  
    IN CNAME	    NVARCHAR(100),  
    IN CNTRY	    NVARCHAR(50), 
    IN CUSTP   	    NVARCHAR(20)
)

   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
--    READS SQL DATA
   AS
BEGIN
    IF :CS_ID =0 THEN
        INSERT INTO CUS (
            CUSID, CNAME, CNTRY, CUSTP,
            ISDEL, CRTDT, CRTTM, CRTBY, CHNDT, CHNTM, CHNBY
        ) VALUES (
            :CUSID, :CNAME, :CNTRY, :CUSTP,
            0, CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER'), CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER')
        );
    ELSE
        UPDATE CUS
        SET 
            CUSID = :CUSID,
            CNAME =:CNAME, 
            CNTRY=:CNTRY, 
            CUSTP =:CUSTP,
            CHNBY = SESSION_CONTEXT('APPLICATIONUSER'),
            CHNDT = CURRENT_DATE,
            CHNTM = CURRENT_TIME
        WHERE CS_ID = :CS_ID AND ISDEL = 0;
    END IF;
 
END;
 