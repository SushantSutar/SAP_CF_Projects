PROCEDURE "prCREATEUPDATE_ATTACH"(
    IN ATTID BIGINT,
    IN EMPID NVARCHAR(20),
    IN CASEI NVARCHAR(20),
    IN FLNAM NVARCHAR(255),
    IN FLTYP NVARCHAR(50),
    IN UPDDT DATE,
    IN FLPTH NVARCHAR(255),
    OUT OATTID BIGINT
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    /*************************************
      Procedure: prCREATEUPDATE_ATTACHMENT
      Purpose  : Insert or update ATTACHMENT record
    *************************************/

    DECLARE COLUMN_ID INTEGER;
    DECLARE QU NVARCHAR(200);
    DECLARE SEQ NVARCHAR(150);

    -- Insert new attachment if ATTID = 0
    IF :ATTID = 0 THEN
        INSERT INTO ATTACHMENT (
            EMPID, CASEI, FLNAM, FLTYP, UPDDT, FLPTH,
            ISDEL, CRTDT, CRTTM, CRTBY, CHNDT, CHNTM, CHNBY
        ) VALUES (
            :EMPID, :CASEI, :FLNAM, :FLTYP, :UPDDT, :FLPTH,
            '0', CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER'),
            CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER')
        );

        -- Fetch auto-generated identity value
        SELECT COLUMN_ID INTO COLUMN_ID 
        FROM TABLE_COLUMNS 
        WHERE TABLE_NAME = 'ATTACHMENT' AND COLUMN_NAME = 'ATTID';

        SELECT '"_SYS_SEQUENCE_' || COLUMN_ID || '_#0_#"' INTO SEQ FROM DUMMY;
        QU := 'SELECT ' || SEQ || '.CURRVAL FROM DUMMY';
        EXECUTE IMMEDIATE QU INTO OATTID;

    ELSE
        -- Update existing attachment record
        UPDATE ATTACHMENT
        SET
            EMPID = :EMPID,
            CASEI = :CASEI,
            FLNAM = :FLNAM,
            FLTYP = :FLTYP,
            UPDDT = :UPDDT,
            FLPTH = :FLPTH,
            CHNBY = SESSION_CONTEXT('APPLICATIONUSER'),
            CHNDT = CURRENT_DATE,
            CHNTM = CURRENT_TIME
        WHERE ATTID = :ATTID AND ISDEL = '0';

        OATTID = :ATTID;
    END IF;

END;
