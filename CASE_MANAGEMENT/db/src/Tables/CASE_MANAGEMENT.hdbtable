COLUMN TABLE "CASE_MANAGEMENT" (
    C__ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY COMMENT 'Primary key - unique case identifier',
    CASEI VARCHAR(100) COMMENT 'case identifier all cases',
    EMPID NVARCHAR(20) COMMENT 'Foreign key - references EMPLOYEE_INFO(EMPID)',
    ASEHS NVARCHAR(100) COMMENT 'Assigned to EHS representative',
    BTYPE NVARCHAR(50)  COMMENT 'Benefit type',
    CDSTS NVARCHAR(50)  COMMENT 'Claim decision status',
    FRTWD DATE          COMMENT 'Forecasted return to work date',
    APDTD DATE          COMMENT 'Approved to date',
    DISDT DATE          COMMENT 'Date of disability',
    LSTWK DATE          COMMENT 'Last date worked',
    WKSTS NVARCHAR(50)  COMMENT 'Work status',
    CSTS  NVARCHAR(50)  COMMENT 'Case status',
    BCSRT DATE          COMMENT 'Benefit claim start date',
    BCEND DATE          COMMENT 'Benefit claim end date',
    LOSRV NVARCHAR(50)  COMMENT 'Length of service',
    LNKFL NVARCHAR(255) COMMENT 'Link to file or document',

    ISDEL NVARCHAR(1) COMMENT 'Delete Flag (Y/N) - logical delete marker',
    CRTDT DATE COMMENT 'Created Date - record creation date',
    CRTTM TIME COMMENT 'Created Time - record creation time',
    CRTBY NVARCHAR(30) COMMENT 'Created By - user who created the record',
    CHNDT DATE COMMENT 'Changed Date - last modification date',
    CHNTM TIME COMMENT 'Changed Time - last modification time',
    CHNBY NVARCHAR(30) COMMENT 'Changed By - user who last modified the record'
)