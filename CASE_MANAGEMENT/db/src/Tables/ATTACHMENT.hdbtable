COLUMN TABLE "ATTACHMENT" (
    ATTID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY COMMENT 'Primary key - unique attachment ID',
    EMPID NVARCHAR(20)  COMMENT 'Foreign key - references EMPLOYEE_INFO(EMPID)',
    CASEI NVARCHAR(20)        COMMENT 'Optional foreign key - references CASE_MANAGEMENT(CASEI)',
    FLNAM NVARCHAR(255) COMMENT 'File name of attachment',
    FLTYP NVARCHAR(50)  COMMENT 'File type (PDF, DOC, etc.)',
    UPDDT DATE          COMMENT 'Upload date',
    FLPTH NVARCHAR(255) COMMENT 'File storage path',

    ISDEL NVARCHAR(1)   COMMENT 'Delete Flag (Y/N) - logical delete marker',
    CRTDT DATE          COMMENT 'Created Date - record creation date',
    CRTTM TIME          COMMENT 'Created Time - record creation time',
    CRTBY NVARCHAR(30)  COMMENT 'Created By - user who created the record',
    CHNDT DATE          COMMENT 'Changed Date - last modification date',
    CHNTM TIME          COMMENT 'Changed Time - last modification time',
    CHNBY NVARCHAR(30)  COMMENT 'Changed By - user who last modified the record'
)