COLUMN TABLE "EMPLOYEE_INFO" (
    E__ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY COMMENT 'Primary key - unique employee identifier',
    EMPID NVARCHAR(20)  COMMENT 'case identifier all cases',
    FNAME NVARCHAR(100) COMMENT 'First name',
    LNAME NVARCHAR(100) COMMENT 'Last name',
    PHON1 NVARCHAR(50)  COMMENT 'Primary phone',
    PHON2 NVARCHAR(50)  COMMENT 'Alternate phone',
    EMAIL NVARCHAR(100) COMMENT 'Primary email address',
    AEMAL NVARCHAR(100) COMMENT 'Alternate email address', 
    GNDR  NVARCHAR(1)   COMMENT 'Gender (M/F/O)',
    DOB   DATE          COMMENT 'Date of birth',
    AGE   INTEGER       COMMENT 'Employee age',
    SAPAD NVARCHAR(255) COMMENT 'SAP address',
    ACTAD NVARCHAR(255) COMMENT 'Actual address',
    PROV  NVARCHAR(100) COMMENT 'Province',
    CITY  NVARCHAR(100) COMMENT 'City',
    POSTC NVARCHAR(20)  COMMENT 'Postal code',
    SIN   NVARCHAR(50)  COMMENT 'Social Insurance Number',
    SAMES NVARCHAR(1)   COMMENT 'Same as SAP address flag (Y/N)',

    ISDEL NVARCHAR(1) COMMENT 'Delete Flag (Y/N) - logical delete marker',
    CRTDT DATE COMMENT 'Created Date - record creation date',
    CRTTM TIME COMMENT 'Created Time - record creation time',
    CRTBY NVARCHAR(30) COMMENT 'Created By - user who created the record',
    CHNDT DATE COMMENT 'Changed Date - last modification date',
    CHNTM TIME COMMENT 'Changed Time - last modification time',
    CHNBY NVARCHAR(30) COMMENT 'Changed By - user who last modified the record'
)